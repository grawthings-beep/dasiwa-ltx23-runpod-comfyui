{
  "name": "DaSiWa WAN 2.2 SynthSeduction v9",
  "imageName": "ghcr.io/grawthings-beep/dasiwa-ltx23-runpod-comfyui:wan22-v9-cu128",
  "category": "NVIDIA",
  "containerDiskInGb": 30,
  "volumeInGb": 80,
  "volumeMountPath": "/workspace",
  "dockerEntrypoint": [],
  "dockerStartCmd": [],
  "env": {
    "PORT": "8188", "LISTEN": "0.0.0.0", "DOWNLOAD_MODELS": "1",
    "MODEL_SOURCE": "auto", "DOWNLOAD_WORKERS": "3", "ARIA2_CONNECTIONS": "16",
    "HF_XET_HIGH_PERFORMANCE": "1", "HF_XET_NUM_CONCURRENT_RANGE_GETS": "16",
    "HF_XET_CHUNK_CACHE_SIZE_BYTES": "0", "HF_HUB_DOWNLOAD_TIMEOUT": "300",
    "CUDA_PREFLIGHT": "1", "CUDA_READY_TIMEOUT": "90", "MODEL_DISK_HEADROOM_GB": "10",
    "COMFYUI_RESERVE_VRAM": "2", "BOOT_FAILURE_HOLD_SECONDS": "900",
    "HF_TOKEN": "{{ RUNPOD_SECRET_HF_TOKEN }}",
    "CIVITAI_API_TOKEN": "{{ RUNPOD_SECRET_CIVITAI_TOKEN }}"
  },
  "isPublic": false,
  "isServerless": false,
  "ports": ["8188/http"],
  "readme": "WAN 2.2 only. Model-free runtime image; exact 36.05 GB v9 weights downloaded on each fresh Pod. Port 8188 shows startup status before ComfyUI is generation-ready. No network volume required."
}
