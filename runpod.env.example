# Networking configuration: HTTP port 8188 (no extra TCP port required).
PORT=8188
LISTEN=0.0.0.0
DOWNLOAD_MODELS=1
MODEL_SOURCE=auto
DOWNLOAD_WORKERS=3
ARIA2_CONNECTIONS=16
HF_XET_HIGH_PERFORMANCE=1
HF_XET_NUM_CONCURRENT_RANGE_GETS=16
HF_XET_CHUNK_CACHE_SIZE_BYTES=0
HF_HUB_DOWNLOAD_TIMEOUT=300
CUDA_PREFLIGHT=1
CUDA_READY_TIMEOUT=90
MODEL_DISK_HEADROOM_GB=10
COMFYUI_RESERVE_VRAM=2
BOOT_FAILURE_HOLD_SECONDS=900
HF_TOKEN={{ RUNPOD_SECRET_HF_TOKEN }}
CIVITAI_API_TOKEN={{ RUNPOD_SECRET_CIVITAI_TOKEN }}
# Optional; normally leave unset:
# WORKSPACE_DIR=/workspace/wan22
# COMFYUI_ARGS=
# NVIDIA_DRIVER_CAPABILITIES and CUDA_VISIBLE_DEVICES: leave RunPod's values.
