# Image: wan22-v9-lipsync-cu128-sha-<successful full commit>
# HTTP port 8188. No start command. No network volume needed.
# /workspace must ACTUALLY have ~60 GB free for all weights + 10GB headroom.
# 100GB Container Disk if /workspace is overlay; or 100GB mounted Pod Volume.
# Keep ample RAM (64GB+); GPU inference/VRAM/quality still need a real test.
LIPSYNC_PROFILE=latentsync-1.6
AUDIO_PROFILE=none
PORT=8188
LISTEN=0.0.0.0
DOWNLOAD_MODELS=1
LORA_PROFILE=all
DOWNLOAD_MOSAIC_MODELS=1
MODEL_SOURCE=auto
DOWNLOAD_WORKERS=3
ARIA2_CONNECTIONS=16
HF_XET_HIGH_PERFORMANCE=1
HF_XET_NUM_CONCURRENT_RANGE_GETS=16
HF_XET_CHUNK_CACHE_SIZE_BYTES=0
HF_HUB_DOWNLOAD_TIMEOUT=300
CUDA_PREFLIGHT=1
CUDA_READY_TIMEOUT=90
MODEL_DISK_HEADROOM_GB=10
COMFYUI_RESERVE_VRAM=2
BOOT_FAILURE_HOLD_SECONDS=900
HF_TOKEN={{ RUNPOD_SECRET_HF_TOKEN }}
CIVITAI_API_TOKEN={{ RUNPOD_SECRET_CIVITAI_TOKEN }}
